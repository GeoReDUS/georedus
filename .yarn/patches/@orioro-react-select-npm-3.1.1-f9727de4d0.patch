+            //
+            // Respect the highlighted item (set via arrow keys/hover)
+            // instead of always picking the first option in the list.
+            // Previously this ignored highlightedIndex entirely, so
+            // e.g. typing "Rio de" + ArrowDown x2 + Enter to highlight
+            // "Rio de Janeiro" would select "Rio de Contas" instead,
+            // since it sorts first alphabetically.
+            //
+            var highlighted = highlightedIndex !== -1 ? options[highlightedIndex] : null;
